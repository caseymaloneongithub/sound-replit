# Copy this file to .env and fill in the values.
# Only DATABASE_URL is required to boot the app.

# LOCAL DEV MACHINES ONLY. NODE_ENV=development boots the Vite dev server AND disables
# staff/admin login 2FA. Never set this on a deployed host — leave NODE_ENV unset there
# (the server treats unset as production).
# NODE_ENV=development
PORT=5000

# Neon Postgres connection string (from Replit → Secrets, or neon.tech)
DATABASE_URL=

# Any random string — signs login session cookies
SESSION_SECRET=change-me

# Public URL of the site. Used for Stripe success/cancel redirects and emailed links.
# REQUIRED IN PRODUCTION — if unset, customers get redirected to localhost after paying.
# APP_URL=https://pugetsoundkombucha.com

# ---- Image storage (S3-compatible: Cloudflare R2, AWS S3, Backblaze B2) ----
# When all of S3_BUCKET / S3_ACCESS_KEY_ID / S3_SECRET_ACCESS_KEY / S3_PUBLIC_BASE_URL
# are set, product & flavor image uploads go to this bucket via presigned PUT.
# Leave unset to fall back to the legacy Replit object storage.
#
# Cloudflare R2 setup:
#   1. Cloudflare dashboard -> R2 -> Create bucket (e.g. "sound-images")
#   2. Bucket -> Settings -> enable public access (r2.dev) or attach a custom domain
#   3. R2 -> Manage API Tokens -> Create token with Object Read & Write for that bucket
#   4. Fill in the values below
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com   # omit entirely for AWS S3
# S3_REGION=auto                                              # "auto" for R2; e.g. us-west-2 for AWS
# S3_BUCKET=sound-images
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_BASE_URL=https://pub-xxxxxxxx.r2.dev              # or https://images.yourdomain.com

# ---- Background jobs ----
# Set to "true" on preview/staging deployments. Suppresses the daily billing run
# (which charges real subscription cards) and the data retention cleanup (which
# deletes expired records). Both jobs also run once on startup, so leaving this
# unset on a test deploy means every container restart attempts a billing run.
# Exactly one deployment should ever run these.
# DISABLE_CRON=true

# ---- Optional integrations (app runs without them) ----
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# PLAID_CLIENT_ID=
# PLAID_SECRET=
# PLAID_ENV=sandbox
# GMAIL_USER=
# GMAIL_APP_PASSWORD=
# MAPBOX_ACCESS_TOKEN=

# Claim-your-store: email a contact when staff approve their request to join a store.
# Leave unset everywhere except production — dev/test databases hold real customer addresses.
# WHOLESALE_APPROVAL_EMAILS=true

# Retail: welcome email ("your account is ready" + set-password link) when staff add a
# customer or press Send welcome. Production only — dev/test hold real addresses.
# RETAIL_WELCOME_EMAILS=true

# ---- Client-side (VITE_) variables ----
# These are baked into the BROWSER BUNDLE AT BUILD TIME — on Railway they must be set
# before the build runs, and changing them requires a redeploy. They are public by
# nature (anyone can read them from the page source); never put secrets in VITE_ vars.
# Stripe PUBLISHABLE key (pk_test_/pk_live_) — must match the mode of STRIPE_SECRET_KEY,
# or checkout renders but every card fails.
# VITE_STRIPE_PUBLIC_KEY=pk_live_...
# Mapbox public token for address autocomplete on customer-facing forms (server-side
# MAPBOX_ACCESS_TOKEN above covers geocoding/routes; they can be the same token).
# VITE_MAPBOX_ACCESS_TOKEN=pk.eyJ...

# Login 2FA (email codes) for password logins — staff, admin, and retail customers.
# Set true to turn 2FA OFF everywhere (owner decision 2026-08-25). Wholesale login is
# magic-link and never had 2FA. (DISABLE_STAFF_2FA works as an alias.)
# DISABLE_LOGIN_2FA=true
